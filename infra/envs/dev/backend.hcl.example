# Copy to backend.hcl and fill in from `terraform output` of infra/bootstrap.
# Then:  terraform init -backend-config=backend.hcl
bucket         = "REPLACE-with-your-state-bucket"
key            = "guruji/dev/terraform.tfstate"
region         = "us-east-1"
dynamodb_table = "guruji-tf-locks"
encrypt        = true
