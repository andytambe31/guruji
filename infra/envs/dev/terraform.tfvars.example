# Copy to terraform.tfvars and adjust.
region           = "us-east-1"
app_origins      = ["https://andytambe31.github.io"]
enable_frontend  = false
alert_email      = "you@example.com"
budget_limit_usd = 5
# The single-user gate. After the first Cognito sign-in, set your subject id
# here (find it in the ID token `sub` or the Cognito console), or list your
# email. Leave both empty to bootstrap the very first login, then lock it down.
allowed_subs   = []
allowed_emails = ["you@example.com"]
